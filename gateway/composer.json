{
    "name": "pangantrace/gateway",
    "type": "project",
    "description": "PanganTrace AI — Laravel API Gateway",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "scripts": {
        "dev": "php artisan serve --port=8080"
    },
    "minimum-stability": "stable"
}
