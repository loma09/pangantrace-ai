# ──────────────────────────────────────────────
# PanganTrace AI — Environment Configuration
# Copy this file to backend/.env and fill in your values
# ──────────────────────────────────────────────

# ── Application ───────────────────────────────
APP_ENV=development
DEBUG=True

# ── Azure OpenAI ──────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_KEY=your_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-11-20

# ── Azure SQL Database ────────────────────────
AZURE_SQL_DATABASE=pangantrace
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_USERNAME=sqladmin
AZURE_SQL_PASSWORD=your_password_here

# ── Azure Event Hub ──────────────────────────
AZURE_EVENTHUB_CONNECTION=Endpoint=sb://your-eventhub.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your_key
AZURE_EVENTHUB_NAME=pangan-transactions

# ── Security ─────────────────────────────────
SECRET_KEY=your-secret-key-here-min-32-chars

# ── Frontend (.env.local) ────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_APP_NAME=PanganTrace AI
