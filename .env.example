# ──────────────────────────────────────────────
# PanganTrace AI — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── Application ───────────────────────────────
APP_ENV=development
DEBUG=true

# ── Azure Anomaly Detector ────────────────────
AZURE_ANOMALY_ENDPOINT=https://your-anomaly.cognitiveservices.azure.com
AZURE_ANOMALY_KEY=your_anomaly_key_here

# ── Azure Machine Learning ────────────────────
AZURE_ML_ENDPOINT=https://your-ml-endpoint.inference.ml.azure.com
AZURE_ML_KEY=your_ml_key_here

# ── Azure OpenAI ──────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_KEY=your_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ── Azure SQL Database ────────────────────────
AZURE_SQL_CONNECTION=Driver={ODBC Driver 18 for SQL Server};Server=your-server.database.windows.net;Database=pangantrace;Uid=admin;Pwd=your_password;Encrypt=yes;TrustServerCertificate=no;

# ── Azure Event Hub (optional) ────────────────
AZURE_EVENTHUB_CONNECTION=Endpoint=sb://your-eventhub.servicebus.windows.net/;SharedAccessKeyName=send;SharedAccessKey=your_key
AZURE_EVENTHUB_NAME=pangantrace-transactions

# ── Azure ML Workspace (for model registry) ───
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP=pangantrace-rg
AZURE_ML_WORKSPACE=pangantrace-ml

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# ── Gateway (Laravel) ─────────────────────────
GATEWAY_APP_KEY=base64:generate_with_php_artisan_key_generate
GATEWAY_DB_HOST=127.0.0.1
GATEWAY_DB_DATABASE=pangantrace_gateway
GATEWAY_DB_USERNAME=root
GATEWAY_DB_PASSWORD=
